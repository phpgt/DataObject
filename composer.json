{
	"description": " Structured, type-safe, immutable data transfer.",
	"name": "phpgt/dataobject",
	"type": "library",

	"require": {
		"php": ">=8.1",
		"ext-json": "*",
		"phpgt/typesafegetter": "^1.3"
	},

	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.1",
		"phpmd/phpmd": "^2.13",
		"squizlabs/php_codesniffer": "^4.0"
	},

	"license": "MIT",

	"authors": [
		{
			"name": "Greg Bowler",
			"email": "greg.bowler@g105b.com"
		}
	],

	"autoload": {
		"psr-4": {
			"GT\\DataObject\\": "./src",
			"Gt\\DataObject\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\DataObject\\Test\\": "./test/phpunit"
		}
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"test": [
			"@phpunit",
			"@phpstan",
			"@phpcs",
			"@phpmd"
		]
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/phpgt"
		}
	],
	"config": {
		"platform": {
			"php": "8.2.0"
		}
	}
}
